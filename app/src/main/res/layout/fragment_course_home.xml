<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:paddingTop="16dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/text_course_streak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔥 0天" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/text_course_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ 0" android:textColor="@color/amber" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今天的意大利语" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:paddingHorizontal="18dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="10dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/home_accent_line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/home_accent_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今天只做这些" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_daily_plan_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="正在整理今天的学习…" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <ProgressBar android:id="@+id/progress_daily_plan" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="11dp" android:max="100" android:progress="0" android:progressTint="@color/blue" android:progressBackgroundTint="@color/line" />
                <TextView android:id="@+id/text_daily_next_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="下一步" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_daily_coach_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_soft_panel" android:padding="10dp" android:text="你只需要完成下一步。" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_daily_plan_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="继续学习" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:minHeight="58dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_home_details_toggle" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="查看今日详情 ▾" android:textAllCaps="false" android:textColor="@color/blue" android:textSize="13sp" android:minHeight="48dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="4dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/text_course_stage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A0 入门" android:textColor="@color/blue" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_course_unit_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="咖啡馆" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_course_unit_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="一步一步完成今天的课程" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <ProgressBar android:id="@+id/progress_course_unit" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp" android:max="100" android:progress="0" android:progressTint="@color/green" android:progressBackgroundTint="@color/line" />
                <TextView android:id="@+id/text_course_daily" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="今天约20分钟 · 只要继续往下学" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="14dp" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_home_quick_words" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="背单词" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="15sp" android:layout_marginTop="6dp" style="@style/Widget.Italiano.PracticeButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_home_quick_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="查看复习日历" android:textAllCaps="false" android:gravity="start|center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="15sp" android:layout_marginTop="6dp" style="@style/Widget.Italiano.PracticeButton" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_home_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="9dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日详细计划" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_daily_plan_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="系统会根据复习压力和薄弱项自动调整。" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="今天准备学习多久（分钟）" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/group_daily_plan_minutes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_plan_10" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="10" android:textAllCaps="false" android:textSize="13sp" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_plan_20" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="20" android:textAllCaps="false" android:textSize="13sp" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_plan_30" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="30" android:textAllCaps="false" android:textSize="13sp" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_plan_45" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="45" android:textAllCaps="false" android:textSize="13sp" android:minHeight="48dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_plan_60" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="60" android:textAllCaps="false" android:textSize="13sp" android:minHeight="48dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <LinearLayout android:id="@+id/container_daily_plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="9dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧠 智能背词" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_smart_memory_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="正在整理今天的复习与新词…" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_smart_memory" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="开始智能背词" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:layout_marginTop="9dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📖 2000词 · 十篇通关" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/text_memory_article_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="10篇主题故事 · 正在读取进度…" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_memory_articles" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="进入十篇通关" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="16dp" android:text="当前单元学习路径" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/container_course_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_course_continue" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp" android:layout_marginTop="5dp" android:text="继续当前单元" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" />
            <TextView android:id="@+id/text_course_next_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="18dp" android:paddingTop="10dp" android:paddingBottom="4dp" android:text="下一单元：基础交流" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>