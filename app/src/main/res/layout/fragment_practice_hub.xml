<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="练习" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_practice_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="主课程已经自动安排复习。这里只在你想额外练某一项时使用。" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <LinearLayout android:id="@+id/container_practice_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:padding="12dp" android:background="@drawable/bg_soft_panel" android:layout_marginTop="12dp" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/layout_practice_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="搜索练习，例如 听力 / 拼写" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_practice_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:singleLine="true" android:imeOptions="actionDone" android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="10dp">
            <com.google.android.material.chip.ChipGroup android:id="@+id/group_practice_category" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:checkedChip="@id/chip_practice_all">
                <com.google.android.material.chip.Chip android:id="@+id/chip_practice_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部" android:checkable="true" android:textSize="14sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_practice_listen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="听说" android:checkable="true" android:textSize="14sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_practice_words" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="词句" android:checkable="true" android:textSize="14sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_practice_grammar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="语法" android:checkable="true" android:textSize="14sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:ensureMinTouchTargetSize="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_practice_life" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实战" android:checkable="true" android:textSize="14sp" style="@style/Widget.MaterialComponents.Chip.Choice" app:ensureMinTouchTargetSize="true" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/check_practice_unlocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="只看已解锁" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_practice_clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="清除搜索和筛选" android:textAllCaps="false" android:visibility="gone" style="@style/Widget.MaterialComponents.Button.TextButton" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_secondary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:id="@+id/text_practice_result_count" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="没有符合条件的练习，试试其他关键词或分类。" android:textSize="15sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:id="@+id/text_practice_empty" android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/section_practice_listen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="听力与开口" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_daily_speaking" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🗣 每日5句开口" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_listen" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🎧🗣 听力与开口" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_pronunciation" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🗣 发音练习" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/section_practice_words" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="词汇与复习" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_weak_story" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="📚 今日弱词微短文" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_wrong" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="❤️ 错题复习" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_error_evidence" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🧾 个人错句本" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_spelling" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="✍️ 拼写练习" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/section_practice_grammar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="语法练习" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_micro_grammar" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🧩 微语法实战" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/section_practice_life" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cardBackgroundColor="@color/surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生活实战" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_life_tasks" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🗺 真实生活任务地图" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_scenarios" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🎭 真实情景会话" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_simple_weekly_exam" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧪 每周实战考试" android:textAllCaps="false" android:gravity="start|center_vertical" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_more_practice" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="更多练习工具 ▾" android:textAllCaps="false" android:textColor="@color/blue" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
        <LinearLayout android:id="@+id/container_advanced_practice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="进阶工具" android:textSize="16sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_reading" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="📖 分级阅读" android:textAllCaps="false" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_sentences" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="💬 核心句子" android:textAllCaps="false" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_grammar" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="🗺 语法知识地图" android:textAllCaps="false" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_verbs" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="🔤 动词变位" android:textAllCaps="false" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_phrases" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="💬 高频短语" android:textAllCaps="false" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_adv_all" style="@style/Widget.Italiano.PracticeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="📊 弱项分析" android:textAllCaps="false" android:textColor="@color/text_secondary" android:minHeight="56dp" android:textSize="15sp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="start|center_vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>